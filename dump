#!/usr/bin/env python3
import sys
import subprocess
import shutil
from pathlib import Path

DEFAULT_ELF = Path("build-clang-debug/kernel/nightingale_kernel")
OBJDUMP = shutil.which("llvm-objdump") or "objdump"

def main():
    elf_path = Path(sys.argv[1]) if len(sys.argv) > 1 else DEFAULT_ELF

    if not elf_path.is_file():
        sys.exit(f"Error: {elf_path} does not exist.")

    cmd = [
        OBJDUMP,
        "-d", "-S",
        "-Mintel",
        "-j.text", "-j.text.low", "-j.init", "-j.fini",
        str(elf_path),
    ]

    # Stream objdump directly into 'less' interactive pager
    try:
        objdump_proc = subprocess.Popen(cmd, stdout=subprocess.PIPE)
        subprocess.run(["less"], stdin=objdump_proc.stdout)
        objdump_proc.wait()
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
