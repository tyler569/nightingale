BasedOnStyle: WebKit

ColumnLimit: 80
PointerAlignment: Right
AlignEscapedNewlines: DontAlign
BreakBeforeBraces: Attach
SpaceInEmptyBraces: Block
AllowShortFunctionsOnASingleLine: Empty

UseTab: Always
IndentWidth: 4
TabWidth: 4

ForEachMacros:
  - vec_foreach
  - rb_for_each
  - list_for_each
  - list_for_each_safe
