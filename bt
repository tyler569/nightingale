#!/usr/bin/env python3
import re
import sys
import subprocess
import shutil
from pathlib import Path

# Paths & Defaults
DEFAULT_ELF = Path("build/kernel/nightingale_kernel")
LOG_FILE = Path("last-output")
ADDR2LINE = shutil.which("llvm-addr2line") or "addr2line"

def find_addresses(text: str) -> list[str]:
    """Extract instruction pointer addresses based on known crash log formats."""

    if matches := re.findall(r"\(0x([0-9a-fA-F]+)\)", text):
        return matches

    if matches := re.findall(r"IP=(?:0x)?([0-9a-fA-F]+)", text):
        return matches

    if matches := re.findall(r"frame ip:\s*(?:0x)?([0-9a-fA-F]+)", text):
        return matches

    if matches := re.findall(r"Fault occurred at\s*(?:0x)?([0-9a-fA-F]+)", text):
        return matches

    return []

def main():
    elf_path = Path(sys.argv[1]) if len(sys.argv) > 1 else DEFAULT_ELF

    if not elf_path.is_file():
        sys.exit(f"Error: ELF file '{elf_path}' not found.")

    if not LOG_FILE.is_file():
        sys.exit(f"Error: Log file '{LOG_FILE}' not found. Run the OS first!")

    log_content = LOG_FILE.read_text(errors="ignore")
    addrs = find_addresses(log_content)

    if not addrs:
        print("No backtrace or crash addresses found in last_output.")
        sys.exit(0)

    # Format addresses with 0x prefix if needed
    formatted_addrs = [a if a.startswith("0x") else f"0x{a}" for a in addrs]
    
    cmd = [ADDR2LINE, "-fips", "-e", str(elf_path)] + formatted_addrs
    subprocess.run(cmd)

if __name__ == "__main__":
    main()
