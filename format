#!/usr/bin/env python3
import subprocess
import shutil
from pathlib import Path

DIRS_TO_FORMAT = ["include", "kernel", "libc", "linker", "user", "arch"]
EXTENSIONS = {".c", ".h"}

def main():
    clang_format = shutil.which("clang-format")
    if not clang_format:
        sys.exit("Error: clang-format not found in PATH.")

    files = [
        str(path)
        for d in DIRS_TO_FORMAT
        for path in Path(d).rglob("*")
        if path.suffix in EXTENSIONS
    ]

    if not files:
        print("No C/header files found to format.")
        return

    print(f"Formatting {len(files)} files with clang-format...")
    subprocess.run([clang_format, "-i"] + files)

if __name__ == "__main__":
    main()
